\u0159\u00edklad obl\u00edben\u00e9 WC bloky, p\u0159elomov\u00e1 \u0159ada \u010dist\u00edc\u00edch prost\u0159edk\u016f bez chloru, kter\u00e1 nejen \u010dist\u00ed, ale tak\u00e9 p\u0159\u00edjemn\u011b von\u00ed, nebo nov\u00e1 baz\u00e9nov\u00e1 chemie.","contains":"5-15%: aniontov\u00e9 povrchov\u011b aktivn\u00ed l\u00e1tky, <5%: b\u011blic\u00ed \u010dinidla na b\u00e1zi kysl\u00edku, neiontov\u00e9 povrchov\u011b aktivn\u00ed l\u00e1tky, parfum, m\u00fddlo, optick\u00e9 zjas\u0148ova\u010de, enzymy, citronellol, citrus aurantium peel oil, limonene, tetramethyl acetyloctahydronaphthalenes","imgDetail":"https:\/\/gapi.globus.cz\/OnlineAsset\/3\/asset?assetID=b5aeae12-07dd-4f00-a46d-63434c56add8&type=1","allergens":[],"nutritionValues":[],"producer":"UNILEVER \u010cR, SPOL. S R.O.","producerId":"30005","storage":null,"productCategories":["cls_czr_washing_powder","cls_czr_detergents_and_softeners","cls_czr_drugstore_and_cosmetics","cls_czr_click_and_collect"],"hasFictiveStock":false,"originalRebateIds":null,"sellUnitSizeText":"65 pran\u00ed","countriesOfOrigin":["RO"],"commonBrand":{"id":"19030","name":"Savo"},"ageLimitation":null,"baseVariantQuantity":1,"articleType":0,"billName":"SAVO UNI 65PD","pointRelevant":false,"regulatedName":"","otherLegalRequirements":"","containsMicronutrients":false,"qcommSell":true,"micronutrients":[],"matlType":"ZHAW","valClass":"Z300","ean":["8720181420405","8720181605192"],"vanr":"02286050007","productTagIds":["CMW29"],"warengroup":"650W1111","name":"Savo prac\u00ed pr\u00e1\u0161ek univerz\u00e1ln\u00ed 65 pran\u00ed","productInHouse":{"globusBonusCredit":null,"actualPrice":389.9,"originalPrice":null,"discountPercentage":null,"priceValidFrom":"2026-10-07T00:00:00.000+02:00","priceValidTo":"2026-10-20T23:59:59.000+02:00","houseNumber":4005,"houseName":"Globus \u010cR, v.o.s. \u010cakovice ","placements":[{"placement":"31108040","facing":1,"presentationType":0,"presentationStock":2,"planogramKey":"1895149","name":"Copy of Praci_p