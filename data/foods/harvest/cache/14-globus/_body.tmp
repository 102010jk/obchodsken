Z300","ean":["107023","20242091","4016414009108","8033874787090","8051827640094","8056157345893","8056697300000","8412276342562","8430697011102","8430697201022","8430748000017","8436036720544","8437000305019","8591189960152","8594009798881","8594018531806","8594023943557","8717755299208","8720648857102"],"vanr":"00138097002","productTagIds":[],"warengroup":"736W3112","name":"Brokolice 500g","productInHouse":{"globusBonusCredit":null,"actualPrice":24.9,"originalPrice":39.9,"discountPercentage":37,"priceValidFrom":"2026-10-07T00:00:00.000+02:00","priceValidTo":"2026-10-13T23:59:59.000+02:00","houseNumber":4005,"houseName":"Globus \u010cR, v.o.s. \u010cakovice ","placements":[{"placement":"06501010","facing":1,"presentationType":0,"presentationStock":2,"planogramKey":"1823293","name":"OZ_065_CAKOVICE","category":"","subcategory":"","department":"Ovoce a zelenina"}],"modified":"2026-10-05T23:22:08.000+02:00","stockAmount":616,"minimumPresentationStock":2,"priceTagId":"11","priceType":"VKA0","comparisonPrice":4.98,"comparisonSaleUnitSizeText":"100,00 g","baseComparisonPrice":49.8,"baseComparisonSaleUnitSizeText":"1 kg","securityTag":false,"availability":"A","blickPunkt":true,"customerClubDiscounts":[],"modifiedStockAmount":"2026-10-09T08:56:20.000+02:00","bonusProgramPrice":null,"GraphicId":123,"Color":"1","isActive":true},"unitId":"g","unitAmount":500,"placementOrder":0,"imgIcon":"https:\/\/gapi.globus.cz\/OnlineAsset\/3\/asset?assetID=2ed2410b-cf15-4d19-aa7f-dace9986f994&type=3","imgThumbnail":"https:\/\/gapi.globus.cz\/OnlineAsset\/3\/asset?assetID=2ed2410b-cf15-4d19-aa7f-dace9986f994&type=2","alias":["brokolice"],"modified":"2026-10-06T02:21:24.000+02:00","imageStepURL":null,"priceCheckerHasPicture":false,"stepID":null,"rabatNumber":null,"originalRebateId":null,"IsBaseVariant":false,"ribbon":{"vSale":{"display":true,"label":"-37 %"}},"badges":[],"calculatedPrice":{"currentPrice":24.9,"normalPrice":39.9}},{"brand":{"brandId":"0","name":"Norm\u00e1ln\u00ed"},"description":"Mango je nejp\u011bstovan\u011bj\u0161\u00edm ovocem na sv\u011bt\u011b a p\u0159\u00edznivci mu p\u0159ezd\u00edvaj\u00ed kr\u00e1lem ovoce \u010di ovoce boh\u016f. M\u00e1 ov\u00e1ln\u00fd a\u017e ledvinovit\u00fd nebo srdcovit\u00fd tvar a je zbarven\u00e9 od zelen\u00e9, p\u0159e\u0161 \u017elutou, oran\u017eovou, \u010dervenou a\u017e po temn\u011b fialov\u00e9 odst\u00edny. Plody lahodn\u00e9 thajsk\u00e9 odr\u016fdy nam dok mai se v\u017edy zbarvuj\u00ed do syt\u011b \u017elut\u00e9. Uprost\u0159ed plodu je ploch\u00e9, ov\u00e1ln\u00e9 a nejedl\u00e9 semeno obalen\u00e9 tvrd\u00fdmi vl\u00e1kny. Plody manga v\u011bt\u0161inou m\u011b\u0159\u00ed mezi 10 a 15 cm. Jejich velikost je z\u00e1visl\u00e1 na odr\u016fd\u011b a podm\u00ednk\u00e1ch p\u011bstov\u00e1n\u00ed. Nejv\u011bt\u0161\u00ed plody mohou v\u00e1\u017eit a\u017e 2 kg. Du\u017eina zral\u00e9ho manga m\u00e1 syt\u011b \u017elutou a\u017e \u017elutooran\u017eovou barvu, je velice \u0161\u0165avnat\u00e1 a sm\u011brem ke st\u0159edu vl\u00e1knit\u00e1. Chu\u0165 a v\u016fn\u011b tohoto ovoce lehce p\u0159ipom\u00edn\u00e1 broskev, ov\u0161em s osobit\u00fdm ko\u0159en\u011bn\u00fdm aroma a vl\u00e1knitou konzistenc\u00ed.<br><br>Mango dozr\u00e1v\u00e1 p\u0159i pokojov\u00e9 teplot\u011b. Zral\u00e9 mango je m\u011bkk\u00e9, na povrchu pru\u017en\u00e9 a velmi citliv\u00e9 na otlaky.<br><br>Mango se nejl\u00e9pe konzumuje pod\u00e9ln\u00fdm rozkrojen\u00edm a odstran\u011bn\u00edm velk\u00e9 pecky. Du\u017eina se z rozkrojen\u00e9ho plodu vybere l\u017ei\u010dkou nebo se plod oloupe a n\u00e1sledn\u011b pokr\u00e1j\u00ed na pl\u00e1tky \u010di kosti\u010dky. Vynikaj\u00edc\u00ed je \u010derstv\u00e9, vychlazen\u00e9, samotn\u00e9 nebo v ovocn\u00fdch i zeleninov\u00fdch sal\u00e1tech.","contains":null,"imgDetail":"https:\/\/gapi.globus.cz\/OnlineAsset\/3\/asset?assetID=90fcb47f-8caa-474f-9d91-14ec045f6f2a&type=1","allergens":[],"nutritionValues":[],"producer":"\u010cEROZFRUCHT S.R.O.","producer