sob, jak se dozv\u011bd\u011bt v\u00edce o Dni mrtv\u00fdch, v\u00fdznamn\u00e9m tradi\u010dn\u00edm mexick\u00e9m sv\u00e1tku<br> \u2022 Barevn\u00e1 dekorace \u2013 Sestaven\u00fd model lze pou\u017e\u00edt jako dekoraci ke dni D\u00eda De Los Muertos<br> \u2022 Tip na d\u00e1rek pro d\u011bti \u2013 Stavebnice p\u0159edstavuje skv\u011bl\u00fd d\u00e1rek pro kluky a holky od 9 let a tak\u00e9 pro milovn\u00edky dekorac\u00ed LEGO\u00ae<br> \u2022 Rozm\u011bry \u2013 Stavebnice se skl\u00e1d\u00e1 z 231 d\u00edlk\u016f a m\u011b\u0159\u00ed p\u0159es 9 cm na v\u00fd\u0161ku, 8 cm na \u0161\u00ed\u0159ku a 10 cm do hloubky","contains":null,"imgDetail":"https:\/\/gapi.globus.cz\/OnlineAsset\/3\/asset?assetID=1a312b75-b482-49d1-a19b-ace536b4a025&type=1","allergens":[],"nutritionValues":[],"producer":"LEGO TRADING S.R.O.","producerId":"39346","storage":null,"productCategories":["cls_czr_toys_lego","cls_czr_building_kit","cls_czr_toys","cls_czr_the_world_of_children","cls_czr_click_and_collect","cls_czr_139142560","cls_czr_hobby_house_and_garden","cls_czr_household"],"hasFictiveStock":false,"originalRebateIds":["30145614"],"sellUnitSizeText":null,"countriesOfOrigin":["CZ"],"commonBrand":{"id":"26406","name":"LEGO"},"ageLimitation":null,"baseVariantQuantity":1,"articleType":0,"billName":"LEGO - 40811","pointRelevant":false,"regulatedName":"","otherLegalRequirements":"","containsMicronutrients":false,"qcommSell":null,"micronutrients":[],"matlType":"ZHAW","valClass":"Z300","ean":["5702017830858"],"vanr":"02442061007","productTagIds":[],"warengroup":"665W6111","name":"LEGO\u00ae Iconic 40811 Olt\u00e1\u0159 mrtv\u00fdch","productInHouse":{"globusBonusCredit":null,"actualPrice":279.9,"originalPrice":359.9,"discountPercentage":22,"priceValidFrom":"2026-10-06T00:00:00.000+02:00","priceValidTo":"2026-10-31T23:59:59.000+01:00","houseNumber":4005,"houseName":"Globus \u010cR, v.o.s. \u010cakovice ","placements":null,"modified":"2026-10-04T22:23:22.000+02:00","stockAmount":40,"min