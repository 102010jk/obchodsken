u00edm b\u011bhem barven\u00ed pro kr\u00e1snou barvu.<br>Bonding maska: Obaluje vlasy ochrannou vrstvou a vytv\u00e1\u0159\u00ed nov\u00e9 mikrovazby pro intenzivn\u00ed p\u00e9\u010di o vlasy.<br><br>Pe\u010duj\u00edc\u00ed permanentn\u00ed barvy Creme Supreme s 3x Bonding HaptIQ syst\u00e9mem od Schwarzkopf jsou k dispozici v \u0161irok\u00e9m v\u00fdb\u011bru 20 kr\u00e1sn\u00fdch odst\u00edn\u016f.","contains":"Aqua,Cetearyl Alcohol,Ammonium Hydroxide,Coconut Alcohol,Sodium Laureth-6 Carboxylate,Sodium,Myreth Sulfate,Ammonium Sulfate,Succinic Acid,Bis-Diisopropanolamino-PG-Propyl Dimethicone\/Bis-Isobutyl PEG-14 Copolymer,Acrylamidopropyltrimonium Chloride\/Acrylates Copolymer,Coco-Glucoside,Paraffinum Liquidum (Mineral Oil, Huile Min\u00e9rale),Glyceryl Oleate,Arginine,Lysine HCl,Ceteareth-12,Ceteareth-20,Potassium Hydroxide,Parfum (Fragrance),Toluene-2,5-Diamine,Sulfate,Sodium Sulfite,Sodium Silicate,Etidronic Acid,Resorcinol,Ascorbic Acid,Sodium Chloride,Butyloctanol,Citric Acid,Polysorbate 20,4-Chlororesorcinol,Linalool,Phenoxyethanol,2-Methylresorcinol,Benzyl Salicylate,Lactic Acid,Citronellol,m-Aminophenol,Geraniol,Limonene,2,7-Naphthalenediol,Ethyl 2,2-Dimethylhydrocinnamal,Sodium Benzoate,Benzyl Alcohol,Methylparaben,Ethylparaben","imgDetail":"https:\/\/gapi.globus.cz\/OnlineAsset\/3\/asset?assetID=248225c6-9637-413f-be10-cb6765fcf606&type=1","allergens":[],"nutritionValues":[],"producer":"HENKEL \u010cR, SPOL. S R.O.","producerId":"32832","storage":"Uchov\u00e1vejte mimo dosah d\u011bt\u00ed.","productCategories":["cls_czr_64045023","cls_czr_64039015","cls_czr_drugstore_and_cosmetics","cls_czr_click_and_collect"],"hasFictiveStock":false,"originalRebateIds":null,"sellUnitSizeText":"60ml","countriesOfOrigin":["DE"],"commonBrand":{"id":"41876","name":"Creme Supreme"},"ageLimitation":null,"baseVariantQuantity":1,"articleType":0,"billName":"SCHW CREME SUPR 60ML","pointRelevant":false,"regulatedName":"Barva na vlasy","otherLegalRequirements":"","containsMicr