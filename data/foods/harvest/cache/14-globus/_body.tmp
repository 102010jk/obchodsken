2:29:33.000+02:00","stockAmount":56,"minimumPresentationStock":6,"priceTagId":"11","priceType":"VKA0","comparisonPrice":9.06,"comparisonSaleUnitSizeText":"100,00 ml","baseComparisonPrice":90.61,"baseComparisonSaleUnitSizeText":"1 l","securityTag":false,"availability":"A","blickPunkt":true,"customerClubDiscounts":[],"modifiedStockAmount":"2026-09-27T18:06:26.000+02:00","bonusProgramPrice":null,"GraphicId":123,"Color":"1","isActive":true},"unitId":"ml","unitAmount":330,"placementOrder":0,"imgIcon":"https:\/\/gapi.globus.cz\/OnlineAsset\/3\/asset?assetID=ba6e4409-b467-475c-b13b-f095d2bc6af8&type=3","imgThumbnail":"https:\/\/gapi.globus.cz\/OnlineAsset\/3\/asset?assetID=ba6e4409-b467-475c-b13b-f095d2bc6af8&type=2","alias":["m\u00edchan\u00fd alkoholick\u00fd n\u00e1poj","p\u00e1lenka"],"modified":"2026-10-06T08:20:35.000+02:00","imageStepURL":null,"priceCheckerHasPicture":false,"stepID":null,"rabatNumber":null,"originalRebateId":null,"IsBaseVariant":false,"ribbon":{"vSale":{"display":true,"label":"-33 %"}},"badges":{"vAgeLimit":{"display":true}},"calculatedPrice":{"currentPrice":29.9,"normalPrice":44.9}},{"brand":{"brandId":"0","name":"Norm\u00e1ln\u00ed"},"description":"D\u016fvod obliby v\u00fdjime\u010dn\u00e9ho lik\u00e9ru Baileys je&nbsp;z\u0159ejm\u00fd - v\u0161echny p\u0159\u00edsady dosahuj\u00ed t\u00e9 nejvy\u0161\u0161\u00ed kvality. Od smetany, kter\u00e1 je&nbsp;do&nbsp;Baileys dopravena do&nbsp;36&nbsp;hodin po nadojen\u00ed od krav, kter\u00e9 se&nbsp;dev\u011bt m\u011bs\u00edc\u016f v&nbsp;roce pasou na&nbsp;zelen\u00fdch irsk\u00fdch pastvin\u00e1ch, p\u0159es pov\u011bstnou \u201e\u017eivou vodu\u201c, tedy origin\u00e1ln\u00ed a&nbsp;jedine\u010dnou t\u0159ikr\u00e1t destilovanou irskou whiskey, a\u017e po kakaov\u00e9 boby, vanilkov\u00e9 lusky a&nbsp;p\u0159\u00edrodn\u00ed aroma, kter\u00e9 lik\u00e9r jemn\u011b dochucuj\u00ed. D\u00edky tradic\u00ed prov\u011b\u0159en\u00e9mu procesu v\u00fdroby a&nbsp;p\u0159irozen\u00e9 schopnosti whiskey konzervovat smetanu, z\u016fst\u00e1v\u00e1 obsah lahve i&nbsp;po 24&nbsp;m\u011bs\u00edc\u00edch stejn\u011b \u010derstv\u00fd a&nbsp;dobr\u00fd, jako v&nbsp;den v\u00fdroby.<br>Baileys si m\u016f\u017eete dop\u0159\u00e1t na mnoho r\u016fzn\u00fdch zp\u016fsob\u016f. Nejobl\u00edben\u011bj\u0161\u00ed je klasicky serv\u00edrovan\u00e1 s&nbsp;ledem, ve skleni\u010dce na vysok\u00e9 no\u017ece, kdy si naplno vychutn\u00e1te jej\u00ed \u00fa\u017easnou chu\u0165. Stejn\u011b tak si ji v&nbsp;zimn\u00edch m\u011bs\u00edc\u00edch m\u016f\u017eete vychutnat v&nbsp;hork\u00fdch n\u00e1poj\u00edch, nap\u0159\u00edklad v k\u00e1v\u011b.<br>D\u016fvod obliby v\u00fdjime\u010dn\u00e9ho lik\u00e9ru Baileys je&nbsp;z\u0159ejm\u00fd - v\u0161echny p\u0159\u00edsady dosahuj\u00ed t\u00e9 nejvy\u0161\u0161\u00ed kvality. Od smetany, kter\u00e1 je&nbsp;do&nbsp;Baileys dopravena do&nbsp;36&nbsp;hodin po nadojen\u00ed od krav, kter\u00e9 se&nbsp;dev\u011bt m\u011bs\u00edc\u016f v&nbsp;roce pasou na&nbsp;zelen\u00fdch irsk\u00fdch pastvin\u00e1ch, p\u0159es pov\u011bstnou \u201e\u017eivou vodu\u201c, tedy origin\u00e1ln\u00ed a&nbsp;jedine\u010dnou t\u0159ikr\u00e1t destilovanou irskou whiskey, a\u017e po kakaov\u00e9 boby, vanilkov\u00e9 lusky a&nbsp;p\u0159\u00edrodn\u00ed aroma, kter\u00e9 lik\u00e9r jemn\u011b dochucuj\u00ed. D\u00edky tradic\u00ed prov\u011b\u0159en\u00e9mu procesu v\u00fdroby a&nbsp;p\u0159irozen\u00e9 schopnosti whiskey konzervovat smetanu, z\u016fst\u00e1v\u00e1 obsah lahve i&nbsp;po 24&nbsp;m\u011bs\u00edc\u00edch stejn\u011b \u010derstv\u00fd a&nbsp;dobr\u00fd, jako v&nbsp;den v\u00fdroby.<br>Baileys si m\u016f\u017eete dop\u0159\u00e1t na mnoho r\u016fzn\u00fdch zp\u016fsob\u016f. Nejobl\u00edben\u011bj\u0161\u00ed je klasicky serv\u00edrovan\u00e1 s&nbsp;ledem, ve skleni\u010dce na vysok\u00e9 no\u017ece, kdy si naplno vychutn\u00e1te jej\u00ed \u00fa\u017easnou chu\u0165. Stejn\u011b tak si ji v&nbsp;zimn\u00edch m\u011bs\u00edc\u00edch m\u016f\u017eete vychu