:3,"priceTagId":"12","priceType":"VKA0","comparisonPrice":35.7,"comparisonSaleUnitSizeText":"100,00 ml","baseComparisonPrice":357,"baseComparisonSaleUnitSizeText":"1 l","securityTag":false,"availability":"A","blickPunkt":true,"customerClubDiscounts":[],"modifiedStockAmount":"2026-10-08T16:06:26.000+02:00","bonusProgramPrice":null,"GraphicId":121,"Color":"1","isActive":true},"unitId":"ml","unitAmount":700,"placementOrder":0,"imgIcon":"https:\/\/gapi.globus.cz\/OnlineAsset\/3\/asset?assetID=d15600b0-70ca-498b-b393-dd04c8691904&type=3","imgThumbnail":"https:\/\/gapi.globus.cz\/OnlineAsset\/3\/asset?assetID=d15600b0-70ca-498b-b393-dd04c8691904&type=2","alias":[],"modified":"2026-10-06T16:11:06.000+02:00","imageStepURL":null,"priceCheckerHasPicture":false,"stepID":null,"rabatNumber":null,"originalRebateId":null,"IsBaseVariant":false,"ribbon":[],"badges":{"vAgeLimit":{"display":true}},"calculatedPrice":{"currentPrice":249.9,"normalPrice":0}},{"brand":{"brandId":"0","name":"Norm\u00e1ln\u00ed"},"description":"Becherovka Original je karlovarsk\u00fd ho\u0159kosladk\u00fd bylinn\u00fd lik\u00e9r (bitter), kter\u00fd si z\u00edskal popularitu nejen v \u010cesk\u00e9 Republice, ale tak\u00e9 tak\u0159ka po cel\u00e9m sv\u011bt\u011b. V\u00fdrobn\u00ed proces se i p\u0159es v\u00edce ne\u017e 200 let existence zna\u010dky nezm\u011bnil a pro v\u00fdrobu se vyu\u017e\u00edvaj\u00ed 100 % p\u0159\u00edrodn\u00ed byliny a ko\u0159en\u00ed poch\u00e1zej\u00edc\u00ed z cel\u00e9ho sv\u011bta. Becherovka vynik\u00e1 ikonick\u00fdm tvarem ji\u017e od roku 1866, kter\u00fd se vyu\u017e\u00edv\u00e1 dodnes. V roce 2016 z\u00edskala Becherovka zlatou medaili v sout\u011b\u017ei World Spirits Competition v San Franciscu. <br>Becherovka je skv\u011bl\u00fd aperitiv a l\u00e9\u010div\u00fd digestiv, kter\u00fd chutn\u00e1 nejl\u00e9pe ledov\u011b vychlazen\u00fd, ide\u00e1ln\u011b na -2 a\u017e -6\u00b0C. Vyu\u017e\u00edv\u00e1 se tak\u00e9 jako sou\u010d\u00e1st mnoha osv\u011b\u017euj\u00edc\u00edch koktejl\u016f, z nich\u017e nejzn\u00e1m\u011bj\u0161\u00ed je tzv. \u201eBeton\u201c. Ten v roce 2017 z\u00edskal ofici\u00e1ln\u00ed ozna\u010den\u00ed \"\u010cesk\u00fd n\u00e1rodn\u00ed koktejl\" dle celon\u00e1rodn\u00edho hlasov\u00e1n\u00ed Mezin\u00e1rodn\u00ed barmansk\u00e9 asociace IBA. Obsah alkoholu 38 %.","contains":"Voda, L\u00edh, Cukr, Sm\u011bs bylin a ko\u0159en\u00ed","imgDetail":"https:\/\/gapi.globus.cz\/OnlineAsset\/3\/asset?assetID=f9c6c6de-3382-45ed-b823-42296c79cf58&type=1","allergens":[],"nutritionValues":[{"title":"atr_czr_alcohol_percentage","value":"38,00 %(obj)","unit":"","referenceUnit":"","name":"Obsah alkoholu"}],"producer":"JAN BECHER - KARLOVARSK\u00c1 BECHEROVKA, A.S.","producerId":"32693","storage":null,"productCategories":["cls_czr_liqueurs","cls_czr_spirits","cls_czr_drinks","cls_czr_click_and_collect"],"hasFictiveStock":false,"originalRebateIds":null,"sellUnitSizeText":"0,5 l","countriesOfOrigin":[],"commonBrand":{"id":"2063","name":"Becherovka"},"ageLimitation":18,"baseVariantQuantity":1,"articleType":0,"billName":"JB BECHEROVKA 0,5L","pointRelevant":false,"regulatedName":"","otherLegalRequirements":"","containsMicronutrients":false,"qcommSell":true,"micronutrients":[],"matlType":"ZHAW","valClass":"Z300","ean":["8594405101537"],"vanr":"00057284002","productTagIds":["CMW29"],"warengroup":"641W7211","name":"Becherovka Original 0,5 l","productInHouse":{"globusBonusCredit":null,"actualPrice":169.9,"originalPrice":null,"discountPercentage":null,"priceValidFrom":"2026-09-22T00:00:00.000+02:00","priceValidTo":"2026-10-12T23:59:59.000+02:00","houseNumber":4005,"houseName":"Globus \u010cR, v.o.s. \u010cakovice ","placements":[{"placement":"58207030","facing":4,"presentationType":0,"presentationStock":8,"planogramKey":"1738548","name":"Alkohol1_11RJ_05","category":"Vino, alkohol","subcategory":"Lihoviny","department":"Vino, alkohol"}],"modified":"2026-09-20T22:29:08.000+02:00","stockAmount":104,"minimumPresentationStock":8